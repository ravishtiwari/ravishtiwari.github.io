<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Display:wght@400;500;700&family=Roboto:wght@300;400;500&family=Roboto+Mono:wght@400;500&family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">
  {% if loadPdf %}<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>{% endif %}
  <link rel="stylesheet" href="/assets/style.css">
  {% if pageStyles %}<link rel="stylesheet" href="{{ pageStyles }}">{% endif %}
</head>
<body class="{{ bodyClass | default('') }}">
  {{ content | safe }}
  <script>window.PORTFOLIO_CONFIG = {{ { defaultTheme: site.defaultTheme, contact: site.contact, resumePath: site.resumePath } | dump | safe }};</script>
  <script src="/assets/site.js"></script>
  {% if pageScript %}<script src="{{ pageScript }}"></script>{% endif %}
</body>
</html>
